@startuml
left to right direction
skinparam packageStyle rectangle

actor "User\n(Librarian)" as User

rectangle "Task 3: Librarian Portal" {
  package "Account Access" {
    usecase "Register Account" as UC_Register
    usecase "Login" as UC_Login
    usecase "Logout" as UC_Logout
    usecase "Validate Registration" as UC_ValidateRegister
    usecase "Validate Login" as UC_ValidateLogin
    usecase "Edit Personal Profile" as UC_EditProfile
  }

  package "Book Submission Management" {
    usecase "Browse Book Submissions" as UC_ViewSubmissions
    usecase "Approve Book Submission" as UC_Approve
    usecase "Reject Book Submission" as UC_Reject
    usecase "Notify Authors" as UC_NotifyAuthors
  }

  package "Book Management" {
    usecase "Get Borrowed Book Records" as UC_GetBorrowedBooksRecords
    usecase "Modify Books" as UC_ModifyBooks
    usecase "Generate Description" as UC_GenerateDescription
    usecase "View Book Change Logs" as UC_ViewBookLogs
  }

  package "Book Request Management" {
    usecase "Notify Requesters" as UC_NotifyRequesters
    usecase "Approve Request" as UC_ApproveRequest
    usecase "Reject Request" as UC_RejectRequest
    usecase "Download Requested Book" as UC_DownloadRequestedBook
    usecase "View Request Statistics" as UC_ViewRequestStatistics
  }

  package "User Management" {
    usecase "Edit User Accounts" as UC_EditAccounts
    usecase "Disable or Activate User Accounts" as UC_DisableActivateAccounts
    usecase "Notify Other Users" as UC_NotifyUsers
  }

  package "Notifications" {
    usecase "Browse Notifications" as UC_BrowseNotifications
    usecase "Archive Notifications" as UC_ArchiveNotifications
    usecase "Delete Notifications" as UC_DeleteNotifications
  }
}

User --> UC_Register
User --> UC_Login
User --> UC_Logout
User --> UC_EditProfile
User --> UC_ViewSubmissions
User --> UC_Approve
User --> UC_Reject
User --> UC_GetBorrowedBooksRecords
User --> UC_ModifyBooks
User --> UC_GenerateDescription
User --> UC_ViewBookLogs
User --> UC_ApproveRequest
User --> UC_RejectRequest
User --> UC_DownloadRequestedBook
User --> UC_ViewRequestStatistics
User --> UC_EditAccounts
User --> UC_DisableActivateAccounts
User --> UC_BrowseNotifications
User --> UC_ArchiveNotifications
User --> UC_DeleteNotifications

UC_Register .> UC_ValidateRegister : include
UC_Login .> UC_ValidateLogin : include
UC_Approve .> UC_NotifyAuthors : include
UC_Reject .> UC_NotifyAuthors : include
UC_ApproveRequest .> UC_NotifyRequesters : include
UC_RejectRequest .> UC_NotifyRequesters : include
UC_EditAccounts .> UC_NotifyUsers : include
UC_DisableActivateAccounts .> UC_NotifyUsers : include
@enduml